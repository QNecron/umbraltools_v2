---
interface Props {
  classes?: string;
  card?: string;
  title?: string;
  copy_1?: string | number;
  copy_2?: string | number;
  copy_3?: string | number;
  copy_4?: string | number;
  copy_5?: string | number;
}

const { 
  classes,
  card = "", 
  title,
  copy_1,
  copy_2,
  copy_3,
  copy_4,
  copy_5
} = Astro.props;
---

<div class={classes ? "card " + classes : "card"} data-card={card}>
  {(title || copy_1 || copy_2 || copy_3 || copy_4 || copy_5) &&
    <div class="card__content">
      {title && 
        <h3 class="card__title" data-heading="4">{title}</h3>
      }
      {copy_1 && 
        <div class="card__copy-1">{copy_1}</div>
      }
      {copy_2 && 
        <div class="card__copy-2">{copy_2}</div>
      }
      {copy_3 && 
        <div class="card__copy-3">{copy_3}</div>
      }
      {copy_4 && 
        <div class="card__copy-4">{copy_4}</div>
      }
      {copy_5 && 
        <div class="card__copy-5">{copy_5}</div>
      }
    </div>
  }
</div>