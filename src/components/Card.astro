---
interface Props {
  card?: string;
  title?: string;
  copy_1?: string | number;
  copy_2?: string | number;
  copy_3?: string | number;
}

const { 
  card = "", 
  title,
  copy_1,
  copy_2,
  copy_3
} = Astro.props;
---

<div class="card" data-card={card}>

  <div class="card__content">

    {title && (
      <h3 class="card__title" data-heading="4">{title}</h3>
    )}

    {copy_1 && (
      <p class="card__copy">{copy_1}</p>
    )}

    {copy_2 && (
      <p class="card__copy">{copy_2}</p>
    )}

    {copy_3 && (
      <p class="card__copy">{copy_3}</p>
    )}

  </div>

</div>