---
import Wrapper from './Wrapper.astro';
import Dialog from './Dialog.tsx';

interface Props {
  nav: Array<{"name": string, "url": string}>;
}

const { nav } = Astro.props;
---

<header id="header" class="header" role="banner">

  <Wrapper>

    <div class="header__nav">

      <a href="/" class="btn" data-btn="primary icon">
        <img 
          src="../d20.svg" 
          class="header__logo-img" 
          height="28" 
          width="28" 
          alt="Umbral Tools" 
        />
      </a>

      <Dialog type="primary" triggerCopy="Menu" triggerButton="primary" client:load>
        <nav class="nav-primary" role="navigation">
          {nav.map((data) => 
            <a href={data.url} class="btn nav-primary__link" data-button="primary">
              {data.name}
            </a>
          )}
        </nav>
      </Dialog>

    </div>

  </Wrapper>

</header>