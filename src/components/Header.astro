---
import Dialog from './Dialog.astro';
import DialogTrigger from './DialogTrigger.astro';

interface Props {
  nav: Array<{"name": string, "url": string}>;
}

const { nav } = Astro.props;
---

<header id="header" class="header" role="banner">

  <a href="/" class="header__logo">
    <img src="d20.png" class="header__logo-img" alt="Umbral Tools"/>
  </a>

  <DialogTrigger 
    dialogName="nav-primary" 
    dialogProps="primary" 
    dialogTitle="Menu" 
  />

  <Dialog dialogName="nav-primary" dialogProps="left">

    <nav class="nav-primary" role="navigation">

    <a href="/" class="nav-primary__link">Home</a>

    {nav.map((data) => 
      <a href={data.url} class="nav-primary__link">
        {data.name}
      </a>
    )}

  </nav>

  </Dialog>

</header>