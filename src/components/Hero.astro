---
interface Props {
  id: string;
  heading?: string;
  title: string;
  imgDesktop: string;
  imgDesktopHeight: string;
  imgDesktopWidth: string;
  imgMobile: string;
  imgMobileHeight: string;
  imgMobileWidth: string;
  alt: string;
  logo?: boolean;
}

const { 
  id, 
  heading = 'h2', 
  title, 
  imgDesktop, 
  imgDesktopHeight,
  imgDesktopWidth,
  imgMobile, 
  imgMobileHeight, 
  imgMobileWidth, 
  alt, 
  logo = false
} = Astro.props;

const Heading = heading === 'h1' ? 'h1' : 'h2';
---
<section 
  id={id} 
  class="hero" 
  role="region" 
  aria-labelledby={id + "-title"}
>

  <picture class="hero__asset">
    <source
      srcset={imgDesktop}
      height={imgDesktopHeight}
      width={imgDesktopWidth}
      media="(min-width: 768px)"
    />
    <img
      src={imgMobile}
      class="hero__asset-img"
      height={imgMobileHeight}
      width={imgMobileWidth}
      fetchpriority="high"
      aria-hidden="true"
      alt={alt}
    />
  </picture>

  <div class="hero__content">

    <Heading 
      id={id + "-title"}
      class="hero__title" 
      data-heading="1"
    >
      {title}
    </Heading>

    {logo && (
      <img 
        src="logo_sd_white.webp" 
        class="hero__logo" 
        height="105"
        width="256"
        alt="ShadowDark" 
      />
    )}

  </div>

</section>