---
interface Props {
  gap?: number | string;
  desktop?: number | string;
  tablet?: number | string;
  mobile?: number | string;
}

const { 
  gap = 16, 
  desktop = 4, 
  tablet = 4, 
  mobile = 2 
} = Astro.props;
---

<div 
  class="grid" 
  data-gap={gap} 
  data-desktop={desktop} 
  data-tablet={tablet} 
  data-mobile={mobile}
>
  <slot />
</div>