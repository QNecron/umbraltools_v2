---
import Icon from './Icon.astro';

interface Props {
  name: string;
  props: string;
}

const { name, props } = Astro.props;
---

<dialog id={name} class="dialog" data-dialog={props}>

  <div class="dialog__content">

    <button 
      class="btn dialog__close"
      commandfor={name} 
      command="close"
      data-btn="primary icon"
    >
      <span class="srt">Close</span>
      <Icon icon="close" />
    </button>

    <slot />

  </div>

</dialog>