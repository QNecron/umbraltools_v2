---
import Page from '../../components/Page.astro';
import Section from '../../components/Section.astro';
import Grid from '../../components/Grid.tsx';
import Card from '../../components/Card.tsx';

import Conditions from '../../data/conditions.json';
---

<Page 
  metaTitle="Conditions | Umbral Tools" 
  metaDescription="Additional rules and information for your ShadowDark campaign."
>

  <Section id="conditions" title="Conditions">

    <Grid desktop="3" tablet="3">

      {Conditions.map((data) => {

        if(data) {
          return(
            <Card 
              card="conditions"
              title={data.name}
              copy_1={data.effect_1}
              copy_5={data.effect_2}
            />
          )
        }

      })}

    </Grid>

  </Section>

</Page>