---
import Page from '../components/Page.astro';
import Hero from '../components/Hero.astro';

import Content from '../data/home.json';
---

<Page 
  metaTitle="Umbral Tools" 
  metaDescription="Toolset for the ShadowDark TTRPG."
>

  {Content.map((data) => {

    // component : hero
    if(data.type === 'hero') {
      return(
        <Hero 
          id={data.id} 
          heading={data.heading} 
          title={data.title} 
          imgDesktop={data.desktop.img} 
          imgDesktopHeight={data.desktop.height} 
          imgDesktopWidth={data.desktop.width} 
          imgMobile={data.mobile.img} 
          imgMobileHeight={data.mobile.height} 
          imgMobileWidth={data.mobile.width} 
          alt={data.alt} 
          logo={true}
        />
      )
    }

  })}

</Page>