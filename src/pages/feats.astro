---
import Page from '../components/Page.astro';
import Section from '../components/Section.astro';
import Grid from '../components/Grid.tsx';
import Card from '../components/Card.tsx';

import Feats from '../data/feats.json';
---

<Page 
  metaTitle="Feats | Umbral Tools" 
  metaDescription="Additional feats for your ShadowDark campaign."
>

  <Section id="feats" title="Feats">

    <Grid desktop="3" tablet="3">

      {Feats.map((data) => {

        if(data) {
          return(
            <Card 
              card="feats"
              title={data.name}
              badge={data.action}
              copy_5={data.description}
            />
          )
        }

      })}

    </Grid>

  </Section>

</Page>